DEEPSEEK_API_KEY=在这里粘贴你的新Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MiniMax 情感 TTS（国内 api.minimaxi.com；JWT 旧 Key 需填 GROUP_ID）
# MINIMAX_API_KEY=你的MiniMax密钥
# MINIMAX_API_BASE=https://api.minimaxi.com/v1
# MINIMAX_GROUP_ID=控制台里的GroupId（sk-api 新 Key 可留空）
# TTS_BACKEND=minimax
# TTS_VOICE=male-qn-qingse
# MINIMAX_MODEL=speech-2.8-hd

# 可选：覆盖 config/companion.yaml 里的 edge 播报设置
# TTS_VOICE=zh-CN-YunxiNeural
# TTS_STYLE=narrative-relaxed
# TTS_RATE=-14%
# TTS_VOLUME=-10%
# TTS_PITCH=-8Hz

# 连续听 / 打断灵敏度（树莓派可按环境微调）
# VAD_ENERGY=450
# BARGE_IN_ENERGY=900
MIC_DEVICE=plughw:3,0
SPK_DEVICE=plughw:0,0
